IPHONEOS_DEPLOYMENT_TARGET = 15.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
CLANG_CXX_LIBRARY = libc++
ENABLE_DEBUG_DYLIB = NO
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = AuthorityHost/Info.plist
PRODUCT_BUNDLE_IDENTIFIER = dev.partydeck.godot.iosauthority
PRODUCT_NAME = $(TARGET_NAME)
SUPPORTED_PLATFORMS = iphonesimulator
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
TARGETED_DEVICE_FAMILY = 1,2
SWIFT_OBJC_BRIDGING_HEADER = $(SRCROOT)/modules/partydeck_ios_probe/PDGodotRuntime.h
OTHER_LDFLAGS = $(inherited) -lc++ -lz -liconv -framework Security
LIBRARY_SEARCH_PATHS = $(inherited) "$(SRCROOT)/build/artifacts"
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
LD_GENERATE_MAP_FILE = YES
LD_MAP_FILE_PATH = $(SRCROOT)/build/evidence/authority-host-LinkMap-$(CONFIGURATION)-$(CURRENT_ARCH).txt
FRAMEWORK_SEARCH_PATHS = $(inherited) "$(SRCROOT)/build/artifacts"
