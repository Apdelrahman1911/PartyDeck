+	for (int channel_index = 0; channel_index < channel_count; channel_index++) {
+		if (!bus->channels[channel_index].effect_instances.is_empty()) {
+			return ERR_UNAVAILABLE;
+		}
+		if (bus->channels[channel_index].buffer.size() != buffer_size || temp_buffer[channel_index].size() != buffer_size) {
+			return ERR_INVALID_DATA;
+		}
+	}
+	{
+		// These temporary iterators end before the first logical deletion.
+		const bool callbacks_present = mix_callback_list.begin() != nullptr || update_callback_list.begin() != nullptr ||
+				listener_changed_callback_list.begin() != nullptr;
+		if (callbacks_present) {
+			return ERR_UNAVAILABLE;
+		}
+	}
+	AudioStreamPlaybackListNode *candidates[64] = {};
+	uint32_t candidate_count = 0;
+	{
+		// This caps only the live preflight, not work already in SafeList graveyards.
+		for (AudioStreamPlaybackListNode *playback : playback_list) {
+			if (candidate_count == 64) {
+				return ERR_UNAVAILABLE;
+			}
+			if (playback == nullptr || playback->stream_playback.is_null() || playback->prev_bus_details == nullptr ||
+					playback->bus_details.load() == nullptr || playback->prev_bus_details == playback->bus_details.load()) {
+				return ERR_INVALID_DATA;
+			}
+			const AudioStreamPlaybackListNode::PlaybackState state = playback->state.load();
+			if (state != AudioStreamPlaybackListNode::FADE_OUT_TO_DELETION && state != AudioStreamPlaybackListNode::AWAITING_DELETION) {
+				return ERR_BUSY;
+			}
