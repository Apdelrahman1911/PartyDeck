+	return r_result.server_buffers_neutral ? OK : ERR_INVALID_DATA;
+}
+
+Error AudioServer::_partydeck_cleanup_retired_playbacks(PartyDeckRetirement &r_result) {
+	if (!Thread::is_main_thread() || !r_result.preflight_passed) {
+		return ERR_INVALID_PARAMETER;
+	}
+	// Caller has released the driver mutex. Successful cleanup runs every queued
+	// destructor; unlink count alone does not establish playback retirement.
+	r_result.playback_cleanup_succeeded = playback_list.maybe_cleanup();
+	if (r_result.playback_cleanup_succeeded) {
+		r_result.retired_playbacks = r_result.unlinked_playbacks;
+	}
+	const bool mix_cleaned = mix_callback_list.maybe_cleanup();
+	const bool update_cleaned = update_callback_list.maybe_cleanup();
+	const bool listener_cleaned = listener_changed_callback_list.maybe_cleanup();
+	r_result.callback_cleanup_succeeded = mix_cleaned && update_cleaned && listener_cleaned;
+	if (r_result.playback_cleanup_succeeded && r_result.callback_cleanup_succeeded) {
+		{
+			for (AudioStreamPlaybackBusDetails *details : bus_details_graveyard_frame_old) {
+				bus_details_graveyard_frame_old.erase(details, [](AudioStreamPlaybackBusDetails *p_details) { delete p_details; });
+			}
+		}
+		{
+			for (AudioStreamPlaybackBusDetails *details : bus_details_graveyard) {
+				bus_details_graveyard.erase(details, [](AudioStreamPlaybackBusDetails *p_details) { delete p_details; });
+			}
+		}
+		// Unlike update's single generation transfer, drain both stopped generations.
+		// No SafeList iterator survives to either destructor pass.
+		r_result.bus_details_cleanup_succeeded = bus_details_graveyard.maybe_cleanup();
+		r_result.old_bus_details_cleanup_succeeded = bus_details_graveyard_frame_old.maybe_cleanup();
+	}
+	r_result.playbacks_remaining = playback_list.begin() != nullptr;
+	r_result.callbacks_remaining = mix_callback_list.begin() != nullptr || update_callback_list.begin() != nullptr ||
+			listener_changed_callback_list.begin() != nullptr;
+	r_result.bus_details_remaining = bus_details_graveyard.begin() != nullptr || bus_details_graveyard_frame_old.begin() != nullptr;
+	r_result.sample_playbacks_remaining = !sample_playback_list.is_empty();
+	r_result.server_buffers_neutral = _partydeck_buffers_neutral();
+	r_result.residuals_observed = true;
+	return r_result.playback_cleanup_succeeded && r_result.callback_cleanup_succeeded &&
+				r_result.bus_details_cleanup_succeeded && r_result.old_bus_details_cleanup_succeeded &&
+				!r_result.playbacks_remaining && !r_result.callbacks_remaining && !r_result.bus_details_remaining &&
+				!r_result.sample_playbacks_remaining && r_result.server_buffers_neutral ?
+			OK : ERR_BUSY;
+}
+
+bool AudioServer::_partydeck_buffers_neutral() const {
+	if (to_mix != 0 || buses.size() != 1 || buses[0] == nullptr) {
+		return false;
+	}
+	const Bus *bus = buses[0];
+	if (bus->soloed || bus->index_cache != 0) {
+		return false;
+	}
+	for (const Bus::Channel &channel : bus->channels) {
+		if (channel.used || channel.active || channel.last_mix_with_audio != 0 ||
+				channel.peak_volume.left != AUDIO_MIN_PEAK_DB || channel.peak_volume.right != AUDIO_MIN_PEAK_DB) {
+			return false;
+		}
+		for (const AudioFrame &frame : channel.buffer) {
+			if (frame.left != 0.0f || frame.right != 0.0f) {
+				return false;
+			}
+		}
+	}
+	for (const AudioFrame &frame : mix_buffer) {
+		if (frame.left != 0.0f || frame.right != 0.0f) {
+			return false;
+		}
+	}
+	for (const Vector<AudioFrame> &buffer : temp_buffer) {
+		for (const AudioFrame &frame : buffer) {
+			if (frame.left != 0.0f || frame.right != 0.0f) {
+				return false;
+			}
+		}
+	}
+	return true;
+}
