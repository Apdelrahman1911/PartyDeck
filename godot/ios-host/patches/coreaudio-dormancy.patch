+	if (!bus->effects.is_empty() || bus->solo || bus->bypass || bus->volume_db != 0.0f || bus->send != StringName()) {
+		return ERR_UNAVAILABLE;
+	}
+	if (channel_count < 1 || channel_count > MAX_CHANNELS_PER_BUS || bus->channels.size() != channel_count ||
+			buffer_size == 0 || mix_buffer.size() != buffer_size + LOOKAHEAD_BUFFER_SIZE || temp_buffer.size() != channel_count) {
+		return ERR_INVALID_DATA;
