+Error AudioDriverCoreAudio::partydeck_retire_closed_playbacks(PartyDeckRetirement &r_result) {
+	r_result = {};
+	if (!Thread::is_main_thread()) {
+		return ERR_INVALID_PARAMETER;
+	}
+	AudioServer *server = AudioServer::get_singleton();
+	if (server == nullptr || AudioDriver::get_singleton() != this || bool(GLOBAL_GET("audio/driver/enable_input"))) {
+		return ERR_UNAVAILABLE;
+	}
+	const auto stopped = [](const PartyDeckOutputState &p_state) {
+		return p_state.observed_on_main_thread && p_state.output_unit_present && !p_state.input_unit_present &&
+				!p_state.active && p_state.output_callbacks_in_flight == 0 && p_state.start_attempts != 0 &&
+				p_state.stop_attempts != 0 && p_state.last_stop_status == noErr &&
+				p_state.stopped_start_attempt == p_state.start_attempts;
+	};
+	const PartyDeckOutputState before = get_partydeck_output_state();
+	if (!stopped(before)) {
+		return ERR_BUSY;
+	}
+	{
+		// AudioOutputUnitStop has already returned. Never stop or wait while locked.
+		MutexLock driver_lock(mutex);
+		const PartyDeckOutputState locked = get_partydeck_output_state();
+		if (AudioDriver::get_singleton() != this || AudioServer::get_singleton() != server ||
+				bool(GLOBAL_GET("audio/driver/enable_input")) || !stopped(locked) ||
+				locked.output_callback_entries != before.output_callback_entries ||
+				locked.start_attempts != before.start_attempts || locked.stop_attempts != before.stop_attempts) {
+			return ERR_BUSY;
+		}
+		Error error = server->_partydeck_retire_closed_playbacks(r_result);
+		if (error != OK) {
+			return error;
+		}
+		samples_in.fill(0);
+		r_result.driver_buffer_neutral = true;
+		for (int32_t sample : samples_in) {
+			if (sample != 0) {
+				r_result.driver_buffer_neutral = false;
+				break;
+			}
+		}
+	}
+	// All iterators and the driver lock are gone before normal unref/destruction.
+	Error error = server->_partydeck_cleanup_retired_playbacks(r_result);
+	const PartyDeckOutputState after = get_partydeck_output_state();
+	r_result.driver_quiescent = AudioDriver::get_singleton() == this && AudioServer::get_singleton() == server &&
+			!bool(GLOBAL_GET("audio/driver/enable_input")) && !server->input_device_active &&
