+	for (uint32_t index = 0; index < candidate_count; index++) {
+		_delete_stream_playback_list_node(candidates[index]);
+		r_result.unlinked_playbacks++;
+	}
+	for (int channel_index = 0; channel_index < channel_count; channel_index++) {
+		Bus::Channel &channel = bus->channels.write[channel_index];
+		channel.buffer.fill(AudioFrame(0, 0));
+		channel.used = false;
+		channel.active = false;
+		channel.peak_volume = AudioFrame(AUDIO_MIN_PEAK_DB, AUDIO_MIN_PEAK_DB);
+		channel.last_mix_with_audio = 0;
+		temp_buffer.write[channel_index].fill(AudioFrame(0, 0));
