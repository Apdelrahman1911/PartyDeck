 class MainLoop;
 
+// PartyDeck diagnostics: scoped on the calling thread, absent outside a native
+// iteration. No scheduling, renderer, input, state or lifetime decisions.
+#ifdef IOS_ENABLED
+struct IOSFrameTimingObserver {
+	enum class Event { MainBegin, Process, RenderSync, RenderDraw, PostRender,
+		PacingBegin, PacingEnd, MainEnd, FixedSleepBegin, DynamicSleepBegin, SleepEnd };
+	void *context = nullptr;
+	void (*callback)(void *, Event, uint32_t) = nullptr;
+	static thread_local IOSFrameTimingObserver *current;
+	static void emit(Event event, uint32_t request_usec = 0) {
+		if (current && current->callback) { current->callback(current->context, event, request_usec); }
+	}
+};
+struct IOSFrameTimingMainScope {
+	IOSFrameTimingObserver *observer = IOSFrameTimingObserver::current;
+	IOSFrameTimingMainScope() {
+		if (observer && observer->callback) {
+			observer->callback(observer->context, IOSFrameTimingObserver::Event::MainBegin, 0);
+		}
+	}
+	~IOSFrameTimingMainScope() {
+		if (observer && observer->callback) {
+			observer->callback(observer->context, IOSFrameTimingObserver::Event::MainEnd, 0);
+		}
+	}
+};
+#endif
