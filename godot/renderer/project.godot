; Shared development project for the two real Last Light presentation prototypes.
; The KMP shell owns rules, networking, navigation, and native lifecycle.
config_version=5

[application]
config/name="PartyDeck — Last Light prototypes"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=60
run/low_processor_mode=true

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/min_width=320
window/size/min_height=360
window/stretch/mode="disabled"
window/handheld/orientation=1
; Match Android fullUser without changing the iOS project default.
window/handheld/orientation.android=6

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.0980392, 0.0823529, 0.14902, 1)
