g-clickable="false" password="false" selected="false" bounds="[126,562][376,605]" /><node index="8" text="Play to accept the last claim, or challenge it. One wrong card catches the bluff. If every card matches, the challenger loses." resource-id="" class="android.widget.TextView" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[126,619][678,741]" /><node index="9" text="" resource-id="" class="android.view.View" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,776][112,860]"><node index="0" text="4" resource-id="" class="android.widget.TextView" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,802][77,835]" /></node><node index="10" text="Watch your lights." resource-id="" class="android.widget.TextView" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[126,790][394,833]" /><node index="11" text="The loser advances a six-light fuse. Its hidden burnout point is fixed for the match. A safe light keeps you in; burnout means you spectate." resource-id="" class="android.widget.TextView" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[126,847][678,1011]" /><node index="12" text=