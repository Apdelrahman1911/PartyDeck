alse" long-clickable="false" password="false" selected="false" bounds="[126,638][355,681]" drawing-order="6" hint="" /><node index="7" text="Everyone gets five hidden cards. Each round asks for Crown, Moon, or Star. Wild cards always match." resource-id="" class="android.widget.TextView" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[126,695][678,817]" drawing-order="7" hint="" /><node index="8" text="" resource-id="" class="android.view.View" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,852][112,936]" drawing-order="8" hint=""><node index="0" text="2" resource-id="" class="android.widget.TextView" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,878][77,911]" drawing-order="0" hint="" /></node><node index="9" text="Make your claim." resource-id="" class="android.widget.TextView" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[126,866][370,909]" drawing-order="9" hint="" /><node index="10" text="On your turn, play one to three cards face down. You claim they all match the table. They don’t have to." resource-id="" class="android.widget.TextView" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="fals