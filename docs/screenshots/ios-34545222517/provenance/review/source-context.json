              "line": 192,
              "text": "    func exerciseFiveCardHand(checkpoint: (String) throws -> Void = { _ in }) throws {"
            },
            {
              "line": 193,
              "text": "        try concealed()"
            },
            {
              "line": 194,
              "text": "        try checkpoint(\"concealed\")"
            },
            {
              "line": 195,
              "text": "        let labels = try reveal(count: 5)"
            },
            {
              "line": 196,
              "text": "        try checkpoint(\"all five native card descriptions\")"
            },
            {
              "line": 197,
              "text": ""
            },
            {
              "line": 198,
              "text": "        // The fifth card must be reached and activated, including a scrolling hand."
            },
            {
              "line": 199,
              "text": "        try toggle(index: 4, count: 5, selected: true)"
            },
            {
              "line": 200,
              "text": "        try wait(\"Selecting the fifth card must enable Play.\") { element(\"game-play\").isEnabled }"
            },
            {
              "line": 201,
              "text": "        try toggle(index: 4, count: 5, selected: false)"
            },
            {
              "line": 202,
              "text": "        try wait(\"Deselecting the fifth card must disable Play.\") { !element(\"game-play\").isEnabled }"
            },
            {
              "line": 203,
              "text": "        for index in 0..<3 { try toggle(index: index, count: 5, selected: true) }"
            },
            {
              "line": 204,
              "text": "        try card(index: 3, count: 5).tap()"
            },
            {
              "line": 205,
              "text": "        try wait(\"A fourth choice must expose the count-only selection limit.\") { text(limitMessage).count == 1 }"
            },
            {
              "line": 206,
              "text": "        let feedback = try reach(text(limitMessage).firstMatch)"
            },
            {
              "line": 207,
              "text": "        if let value = feedback.value {"
            },
            {
              "line": 208,
              "text": "            try require((value as? String).map { $0.isEmpty || $0 == limitMessage } == true,"
            },
            {
              "line": 209,
              "text": "                        \"Selection-limit feedback must not add private card information.\")"
            },
            {
              "line": 210,
              "text": "        }"
            },
            {
              "line": 211,
              "text": "        for index in 0..<5 {"
            },
            {
              "line": 212,
              "text": "            try state(index: index, count: 5, selected: index < 3, expectedLabel: labels[index])"
            },
            {
              "line": 213,
              "text": "        }"
            },
            {
              "line": 214,
              "text": "        try require(text(\"3 of 3 selected\").count == 1 && element(\"game-play\").isEnabled,"
            },
            {
              "line": 215,
              "text": "                    \"Rejecting a fourth card must retain exactly the first three selections.\")"
            },
            {
              "line": 216,
              "text": "        try checkpoint(\"maximum selection and count-only feedback\")"
            },
            {
              "line": 217,
              "text": ""
            },
            {
              "line": 218,
              "text": "        try toggle(index: 1, count: 5, selected: false)"
            },
            {
              "line": 219,
              "text": "        try wait(\"Deselecting must clear the limit feedback and update the public count.\") {"
            },
            {
              "line": 220,
              "text": "            text(limitMessage).count == 0 && text(\"2 of 3 selected\").count == 1"
            },
            {
              "line": 221,
              "text": "        }"
            },
            {
              "line": 222,
              "text": "        for index in 0..<5 {"
            },
            {
              "line": 223,
              "text": "            try state(index: index, count: 5, selected: index == 0 || index == 2, expectedLabel: labels[index])"
            },
            {
              "line": 224,
              "text": "        }"
            },
            {
              "line": 225,
              "text": "        try hide(labels: labels)"
            },
            {
              "line": 226,
              "text": "        try checkpoint(\"Hide removes private nodes and selection\")"
            },
            {
              "line": 227,
              "text": "        _ = try reveal(count: 5, expectedLabels: labels)"
            },
            {
              "line": 228,
              "text": "        try checkpoint(\"fresh Reveal is unselected\")"
            },
            {
              "line": 229,
              "text": "        try hide(labels: labels)"
            }
          ]
        }
