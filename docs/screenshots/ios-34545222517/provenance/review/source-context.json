              "line": 36,
              "text": "        waitUntil(\"Playing one card must change the authoritative hand or produce a round outcome.\") {"
            },
            {
              "line": 37,
              "text": "            !lastCard.exists && (fourthCard.exists || roundResult.exists || winner.exists)"
            },
            {
              "line": 38,
              "text": "        }"
            },
            {
