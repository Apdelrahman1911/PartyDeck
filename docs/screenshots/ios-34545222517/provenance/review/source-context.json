            {
              "line": 9,
              "text": "    func testSharedHomeOpensAPlayablePracticeTable() throws {"
            },
            {
              "line": 10,
              "text": "        let app = XCUIApplication()"
            },
            {
              "line": 11,
              "text": "        app.launch()"
            },
            {
              "line": 12,
              "text": ""
            },
            {
              "line": 13,
              "text": "        let practice = element(\"home-practice\", in: app)"
            },
            {
              "line": 14,
              "text": "        XCTAssertTrue(practice.waitForExistence(timeout: 30), \"The shared Compose home must render.\")"
            },
            {
              "line": 15,
              "text": "        XCTAssertTrue(element(\"home-host\", in: app).exists)"
            },
            {
              "line": 16,
              "text": "        XCTAssertTrue(element(\"home-join\", in: app).exists)"
            },
            {
              "line": 17,
              "text": "        capture(\"Home\", app: app)"
            },
            {
              "line": 18,
              "text": ""
            },
            {
              "line": 19,
              "text": "        practice.tap()"
            },
            {
              "line": 20,
              "text": "        XCTAssertTrue(element(\"game-table\", in: app).waitForExistence(timeout: 15), \"Practice must reach the actual game UI.\")"
            },
            {
              "line": 21,
              "text": "        waitForPlayableTurn(in: app)"
            },
            {
              "line": 22,
              "text": ""
            },
            {
              "line": 23,
              "text": "        let standard = StandardTableAcceptance(app)"
            },
            {
              "line": 24,
              "text": "        try standard.exerciseFiveCardHand { checkpoint in"
            },
            {
              "line": 25,
              "text": "            capture(\"Practice Standard \\(checkpoint)\", app: app)"
            },
            {
              "line": 26,
              "text": "            try standard.audit()"
            },
            {
              "line": 27,
              "text": "        }"
            },
            {
              "line": 28,
              "text": "        _ = try standard.reveal(count: 5)"
            },
            {
              "line": 29,
              "text": "        try standard.toggle(index: 0, count: 5, selected: true)"
            },
            {
              "line": 30,
              "text": "        let lastCard = element(\"game-card-4\", in: app)"
            },
            {
              "line": 31,
              "text": "        let play = try standard.control(\"game-play\")"
            },
            {
              "line": 32,
              "text": "        play.tap()"
            },
            {
              "line": 33,
              "text": "        let fourthCard = element(\"game-card-3\", in: app)"
            },
            {
              "line": 34,
              "text": "        let roundResult = element(\"game-round-result\", in: app)"
            },
            {
              "line": 35,
              "text": "        let winner = element(\"game-winner\", in: app)"
            },
