              "line": 20,
              "text": "    private func exercise(_ mode: Mode) async throws {"
            },
            {
              "line": 21,
              "text": "        lastObservation = nil"
            },
            {
              "line": 22,
              "text": "        lastDocument = nil"
            },
            {
              "line": 23,
              "text": "        let app = XCUIApplication()"
            },
            {
              "line": 24,
              "text": "        app.launchArguments = [\"--partydeck-observe-godot-session\"] // Observation only; never enables a mode."
            },
            {
              "line": 25,
              "text": "        app.launch()"
            },
            {
              "line": 26,
              "text": "        do {"
            },
            {
              "line": 27,
              "text": "            let home = try await wait(app, \"The opted-in observation must exist on the actual Home screen.\", timeout: 30) {"
            },
            {
              "line": 28,
              "text": "                $0.controller?.screen == \"HOME\" && $0.controller?.sessionPresent == false &&"
            },
            {
              "line": 29,
              "text": "                    self.element(\"home-practice\", app).isHittable"
            },
            {
              "line": 30,
              "text": "            }"
            },
            {
              "line": 31,
              "text": "            try require(!home.port.ownerCreated, \"Observation must not acquire a native engine before the user selects a renderer.\")"
            },
            {
              "line": 32,
              "text": "            try await tapElement(\"home-practice\", app)"
            },
            {
              "line": 33,
              "text": "            let practice = try await playablePractice(app)"
            },
            {
              "line": 34,
              "text": "            let practiceState = try controller(practice)"
            },
            {
              "line": 35,
              "text": "            let generation = practiceState.sessionGeneration"
            },
            {
              "line": 36,
              "text": "            try require(!practice.port.ownerCreated, \"The real Standard practice session must not eagerly acquire Godot.\")"
            },
            {
              "line": 37,
              "text": "            try require(practiceState.handCount == 5, \"Full native hand acceptance requires the fresh five-card hand before any Play.\")"
            },
            {
              "line": 38,
              "text": "            try StandardTableAcceptance(app).exerciseFiveCardHand { checkpoint in"
            },
            {
              "line": 39,
              "text": "                guard let observed = try read(app) else { throw Failure(\"Native hand acceptance requires the real session observation.\") }"
            },
            {
              "line": 40,
              "text": "                let state = try controller(observed)"
            },
            {
              "line": 41,
              "text": "                try require(state.sessionGeneration == generation && state.sessionRevision == practiceState.sessionRevision &&"
            },
            {
              "line": 42,
              "text": "                    state.lastViewerReceipt?.serial == practiceState.lastViewerReceipt?.serial && state.handCount == 5 &&"
            },
            {
              "line": 43,
              "text": "                    state.mode == \"COMPOSE\" && state.ownTurn && state.canPlay && !observed.port.ownerCreated,"
            },
            {
              "line": 44,
              "text": "                    \"Reveal, native card toggles and Hide must preserve the real session without an authority action or engine acquisition.\")"
            },
            {
              "line": 45,
              "text": "                capture(\"\\(mode.rawValue) Standard \\(checkpoint)\", app)"
            },
            {
              "line": 46,
              "text": "            }"
            },
            {
              "line": 47,
              "text": ""
            },
            {
              "line": 48,
              "text": "            let first = try await enter(mode, app, session: generation)"
            },
            {
              "line": 49,
              "text": "            capture(\"\\(mode.rawValue) production concealed entry\", app)"
            },
            {
              "line": 50,
              "text": "            try await revealSelectHide(mode, app, session: generation)"
            },
            {
              "line": 51,
              "text": "            let reveal = try await tapRenderer(\"reveal\", mode, app, session: generation)"
            },
            {
              "line": 52,
              "text": "            _ = try await live(mode, app, session: generation, after: reveal) { !$0.renderer.handConcealed }"
            },
            {
              "line": 53,
              "text": "            let card = try await tapRenderer(\"card\", mode, app, session: generation, cardIndex: 0)"
            },
            {
              "line": 54,
              "text": "            _ = try await live(mode, app, session: generation, after: card) {"
            },
            {
              "line": 55,
              "text": "                $0.renderer.selectedCount == 1 && $0.renderer.control(\"card\", index: 0)?.selected == true"
            }
          ]
        },
