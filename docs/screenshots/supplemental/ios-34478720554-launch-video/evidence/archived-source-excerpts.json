              "line": 41,
              "text": "            guard FileManager.default.isReadableFile(atPath: pack.path) else { throw HostFailure.resourcesMissing }"
            },
            {
              "line": 42,
              "text": "            let facade = try IosQualificationFactory.shared.create("
