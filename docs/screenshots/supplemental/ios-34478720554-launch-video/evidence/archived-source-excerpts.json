              "line": 20,
              "text": "    private var closing = false"
            },
            {
              "line": 21,
              "text": "    private var generation: UInt64 = 0"
            },
            {
              "line": 22,
              "text": "    private var receipt: [String: Any] = [:]"
            },
            {
              "line": 23,
              "text": "    private var lastDiagnosticRequestAt: TimeInterval = 0"
