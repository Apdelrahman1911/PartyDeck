              "line": 28,
              "text": ""
            },
            {
              "line": 29,
              "text": "    func start(mode selectedMode: String, reduceMotion: Bool, soundEnabled: Bool, textScale: Double) {"
            },
            {
              "line": 30,
              "text": "        precondition(Thread.isMainThread)"
            },
