 selected="false" bounds="[126,314][370,357]" /><node index="4" text="On your turn, play one to three cards face down. You claim they all match the table. They don’t have to." resource-id="" class="android.widget.TextView" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[126,371][678,493]" /><node index="5" text="" resource-id="" class="android.view.View" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,528][112,612]"><node index="0" text="3" resource-id="" class="android.widget.TextView" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,554][77,587]" /></node><node index="6" text="Trust it. Or call it." resource-id="" class="android.widget.TextView" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[126,542][376,585]" /><node index="7" text="Play to accept the last claim, or challenge it. One wrong card catches the bluff. If every card matches, the challenger loses." resource-id="" class="android.widget.TextView" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[126,599][678,721]" /><node index="8" text="" resource-id="" class="android.view.View" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,756][112,840]"><node index="0" text="4" resource-id="" class="android.widget.TextView" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,782][77,815]" /></node><node index="9" text="Watch your lights." resource-id="" class="android.widget.TextView" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[126,770][394,813]" /><node index="10" text="The loser advances a six-light fuse. Its hidden burnout point is fixed for the match. A safe light keeps you in; burnout means you spectate." resource-id="" class="android.widget.TextView" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[126,827][678,991]" /><node index="11" text="" resource-id="" class="android.view.View" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,1026][112,1110]"><node index="0" text="5" resource-id="" class="android.widget.TextView" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1052][77,1085]" /></node><nod