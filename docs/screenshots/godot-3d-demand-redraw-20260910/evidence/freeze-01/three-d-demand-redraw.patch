+		_viewport_dirty = false
+		_position_targets()
+		_viewport_requested_signature = _viewport_frame_signature()
+		_viewport_draw_pending = true
+		_viewport.render_target_update_mode = SubViewport.UPDATE_ONCE
+	else:
