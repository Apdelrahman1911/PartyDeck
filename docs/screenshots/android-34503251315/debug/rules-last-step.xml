 selected="false" bounds="[126,303][370,346]" /><node index="4" text="On your turn, play one to three cards face down. You claim they all match the table. They don’t have to." resource-id="" class="android.widget.TextView" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[126,360][678,482]" /><node index="5" text="" resource-id="" class="android.view.View" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,517][112,601]"><node index="0" text="3" resource-id="" class="android.widget.TextView" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,543][77,576]" /></node><node index="6" text="Trust it. Or call it." resource-id="" class="android.widget.TextView" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[126,531][376,574]" /><node index="7" text="Play to accept the last claim, or challenge it. One wrong card catches the bluff. If every card matches, the challenger loses." resource-id="" class="android.widget.TextView" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[126,588][678,710]" /><node index="8" text="" resource-id="" class="android.view.View" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,745][112,829]"><node index="0" text="4" resource-id="" class="android.widget.TextView" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,771][77,804]" /></node><node index="9" text="Watch your lights." resource-id="" class="android.widget.TextView" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[126,759][394,802]" /><node index="10" text="The loser advances a six-light fuse. Its hidden burnout point is fixed for the match. A safe light keeps you in; burnout means you spectate." resource-id="" class="android.widget.TextView" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[126,816][678,980]" /><node index="11" text="" resource-id="" class="android.view.View" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,1015][112,1099]"><node index="0" text="5" resource-id="" class="android.widget.TextView" package="dev.partydeck.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1041][77,1074]" /></node><nod