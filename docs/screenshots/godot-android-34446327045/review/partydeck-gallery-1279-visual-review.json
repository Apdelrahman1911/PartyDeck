  "findings": {
    "focused_3d_200_percent": [
      "Pinned Star table, round, actor and Show/Hide remain visible while scrolling.",
      "The default selected-hand frame shows complete rank actions and Play 2. Three-card limit feedback and deselection remain legible.",
      "The six-seat long-name roster uses horizontal scrolling. In some long-name selected frames the first selected card is above the scroll clip; the focused last card, Play and Return remain visible. Not every card is simultaneously fully visible.",
      "Covered and resumed frames contain no private faces or labels.",
      "The long-name lobby confirmation shows the full consequence and both complete buttons.",
      "Static recipient-safe desktop fixtures and emulated input do not establish native-device execution or authority-accepted gameplay."
    ],
    "reveal_investigation": [
      "Both baseline normal-text early/late frames clip the bottom of Reveal and the concealed panel.",
      "Both adjusted normal-text frames show complete Reveal and concealed panel, consistent with the recorded eight-logical-unit panel margin.",
      "All four 200% baseline/candidate PNGs are byte-identical and show complete Reveal and panel; disabled gameplay content continues below the viewport.",
      "The four failed-fixture scene captures show readable selection and privacy clearing; there is no lobby-confirmation capture for that failed fixture.",
      "The five corrected-permission-fixture captures show complete initial Reveal, selection, concealed Hide/resume and lobby confirmation.",
      "These source fixtures do not establish native execution or an authority-accepted lobby action."
    ],
    "android_2d": [
      "At normal text, initial Reveal is still clipped on all three fresh entries. Covered/resumed Reveal fits after scrolling.",
      "Home and opaque Recents previews contain no private faces or labels at either text scale.",
      "Normal result/winner frames show public Moon, the named challenge and burnout explanation, and complete next/return controls.",
      "At 200%, initial Reveal fits; gameplay/result controls and parts of explanations continue below the captured viewport. Later retained input and teardown records establish reachability.",
      "Final images show the restored chooser; at 200% open-source notices are below the initial viewport.",
      "The later source-only Reveal height correction is absent from this CI pack."
    ],
    "android_3d": [
      "Normal concealed, revealed, selected, covered and same-process resumed frames show complete hand controls and primary action; the roster uses horizontal scrolling.",
      "Home and opaque Recents previews contain no private faces or labels at either text scale. Covered and resumed frames are concealed.",
      "Normal result/winner frames show public Moon, the named challenge and burnout explanation, and complete Next round or Back to room controls.",
      "At 200%, Show/Hide and Star table, round and actor stay pinned. Some card faces and rank actions lie outside the current scroll viewport.",
      "At 200%, result action controls are partly or entirely below the capture viewport. The winner explanation is readable; the table and return action continue below the viewport. Later retained input/teardown records establish reachability.",
      "Match-return, scene-Exit and final-screen images show restored choosers; notices are below the 200% initial viewport.",
      "Both final native Back entries lack a success-specific chooser PNG and fail the requested route. Final-screen shows the chooser after failure and must not be labeled a passing Back route."
    ]
  },
